# ============================================
# 运动姿态评估与纠错系统 - 环境变量配置
# ============================================
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# 数据库连接
# SQLite: sqlite:///./pose_evaluation.db
# MySQL:  mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./pose_evaluation.db

# Redis 连接（用于 Celery 任务队列）
REDIS_URL=redis://localhost:6379/0

# 文件存储根目录
STORAGE_ROOT=storage

# JWT 密钥 - 务必修改为安全随机字符串！
# 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-key

# 可选配置
# ACCESS_TOKEN_EXPIRE_DAYS=7

# AI 大模型（百度千帆）
# 复制为 .env 后填写 AI_API_KEY；模型需在控制台已开通，见千帆模型列表
AI_API_URL=https://qianfan.baidubce.com/v2/chat/completions
AI_API_KEY=bce-v3/ALTAK-eaIZc5BJdk8DIj43yyctw/f94face031c4335e0a358008b355ed580b341578
AI_MODEL=ernie-4.5-turbo-32k
AI_API_TIMEOUT=60