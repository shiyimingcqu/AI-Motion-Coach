/* 训练页 - 设计稿风格 */
.training-page {
  width: 100%;
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

/* 顶部栏 */
.top-bar {
  background: #fff;
  position: relative;
  z-index: 100;
}

.top-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 56rpx;
  color: var(--text);
  line-height: 1;
}

.exercise-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.top-bar-right {
  display: flex;
  gap: 12rpx;
}

.topbar-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text);
}

/* 倒计时覆盖层 */
.countdown-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.countdown-number {
  font-size: 200rpx;
  font-weight: 700;
  color: #4f8cff;
  text-shadow: 0 0 40rpx rgba(79, 140, 255, 0.5);
}

.countdown-tip {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 20rpx;
}

/* 摄像头 */
.camera-container {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 16rpx 24rpx;
  border-radius: var(--radius-lg);
  background: #000;
}

.camera-wrapper {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-lg);
}

.live-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 77, 79, 0.9);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  z-index: 10;
}

.live-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.live-badge text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 语音播报开关 */
.voice-toggle {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  z-index: 10;
  transition: background 0.2s;
}

.voice-on {
  background: rgba(79, 140, 255, 0.7);
}

.voice-off {
  background: rgba(0, 0, 0, 0.5);
}

/* 反馈气泡 */
.feedback-bubbles {
  position: absolute;
  top: 24%;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 10;
  pointer-events: none;
}

.bubble {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #fff;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

/* 错误提示气泡：橙色 */
.bubble-error {
  background: rgba(255, 138, 91, 0.92);
}

/* 纠正建议气泡：蓝色 */
.bubble-advice {
  background: rgba(79, 140, 255, 0.92);
}

.bubble-icon {
  font-size: 24rpx;
}

.bubble-text {
  font-size: 24rpx;
  font-weight: 500;
}

/* 指标行 */
.metrics-row {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx 0;
}

.metric-card {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
}

.metric-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent-blue);
  display: block;
  line-height: 1.1;
}

.metric-label {
  font-size: 24rpx;
  color: var(--text);
  margin-top: 8rpx;
  display: block;
}

.metric-target {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

/* 计数行 */
.count-row {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx 0;
}

.count-block {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.count-block-highlight {
  background: linear-gradient(135deg, #fff4ee 0%, #ffe9df 100%);
}

.count-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.1;
}

.count-unit {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
}

.count-label {
  font-size: 24rpx;
  color: var(--text);
  margin-top: 8rpx;
}

/* 控制按钮行 */
.controls-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  gap: 16rpx;
}

.ctrl-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
  width: 140rpx;
}

.ctrl-mini-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: var(--shadow-card);
}

.ctrl-mini-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.ctrl-main {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f8cff 0%, #2f6fe0 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(79, 140, 255, 0.4);
}

.ctrl-main-start {
  background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
  box-shadow: 0 8rpx 24rpx rgba(52, 211, 153, 0.4);
}

.ctrl-main-icon {
  font-size: 44rpx;
  line-height: 1;
}

.ctrl-main-text {
  font-size: 22rpx;
  font-weight: 600;
}

/* 动作切换 tab */
.action-tabs {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 24rpx 0;
  overflow-x: auto;
}

.action-tab {
  flex: 1;
  min-width: 130rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: var(--shadow-card);
  transition: all 0.2s;
}

.action-tab-active {
  background: linear-gradient(135deg, #4f8cff 0%, #2f6fe0 100%);
}

.action-tab-active .action-tab-text {
  color: #fff;
}

.action-tab-icon {
  font-size: 40rpx;
}

.action-tab-text {
  font-size: 22rpx;
  color: var(--text);
  font-weight: 500;
}

.action-tab-active .action-tab-text {
  color: #fff;
}

/* 调试面板 */
.debug-panel {
  margin: 16rpx 24rpx 0;
  background: rgba(0, 0, 0, 0.8);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.debug-title {
  font-size: 22rpx;
  color: #fbbf24;
  font-weight: 600;
  margin-bottom: 8rpx;
  display: block;
}

.debug-row {
  display: flex;
  gap: 20rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.8;
}

.debug-error {
  color: #ef4444;
  word-break: break-all;
}

/* 调试按钮 */
.debug-buttons {
  padding: 16rpx 24rpx 0;
}

.debug-btn {
  background: #fff;
  color: var(--text-secondary);
  font-size: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-full);
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
}
