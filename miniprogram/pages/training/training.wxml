<!-- 训练页 - 摄像头实时检测 + Canvas 骨架叠加 + WebSocket 评分 -->
<view class="training-page">
  <!-- 隐藏的视频元素（用于视频调试提取帧） -->
  <video id="debugVideoEl" hidden></video>
  <canvas
    type="2d"
    id="frameCanvas"
    style="position: fixed; left: -9999px; top: -9999px; width: 1px; height: 1px;"
  ></canvas>
  <!-- 自定义顶部栏 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar-content">
      <view class="back-btn" bindtap="handleBack">← 返回</view>
      <text class="exercise-name">{{exerciseName}}</text>
      <view class="debug-toggle" bindtap="toggleCamera">{{cameraPosLabel}}</view>
      <view class="debug-toggle" bindtap="toggleDebug">调试</view>
    </view>
  </view>

  <!-- 倒计时覆盖层 -->
  <view class="countdown-overlay" wx:if="{{state === 'countdown'}}">
    <text class="countdown-number">{{countdown}}</text>
    <text class="countdown-tip">准备开始</text>
  </view>

  <!-- 摄像头区域 -->
  <view class="camera-container">
    <view class="camera-wrapper" style="width: {{cameraWidth}}px; height: {{cameraHeight}}px;">
      <video
        wx:if="{{isDemoMode}}"
        id="demoVideo"
        src="{{demoVideoSrc}}"
        autoplay="{{false}}"
        loop="{{false}}"
        muted="{{true}}"
        controls="{{false}}"
        object-fit="cover"
        style="width: 100%; height: 100%;"
      ></video>
      <camera
        wx:else
        id="trainingCamera"
        device-position="{{cameraPosition}}"
        flash="off"
        mode="normal"
        binderror="onCameraError"
        style="width: 100%; height: 100%;"
      ></camera>

      <!-- 骨架叠加 -->
      <skeleton-overlay
        id="skeleton"
        keypoints="{{currentKeypoints}}"
        mirrored="{{cameraPosition === 'front'}}"
        canvas-width="{{cameraWidth}}"
        canvas-height="{{cameraHeight}}"
      ></skeleton-overlay>
    </view>

    <!-- 状态指示 -->
    <view class="camera-status" wx:if="{{state !== 'running'}}">
      <view class="status-badge">
        <text>{{state === 'paused' ? '已暂停' : state === 'finished' ? '训练结束' : '准备中'}}</text>
      </view>
    </view>
  </view>

  <!-- 调试面板 -->
  <view class="debug-panel" wx:if="{{showDebug}}">
    <text class="debug-title">调试信息</text>
    <view class="debug-row">
      <text>状态: {{state}}</text>
      <text>WS: {{debugWsStatus}}</text>
    </view>
    <view class="debug-row">
      <text>帧发送: {{debugFrames}}</text>
      <text>帧有效: {{debugOkFrames}}</text>
      <text>错误: {{debugErrors}}</text>
    </view>
    <view class="debug-row" wx:if="{{debugFrameSize}}">
      <text>帧尺寸: {{debugFrameSize}}</text>
    </view>
    <view class="debug-row" wx:if="{{debugLastError}}">
      <text class="debug-error">{{debugLastError}}</text>
    </view>
  </view>

  <!-- 训练信息面板 -->
  <view class="info-panel">
    <!-- 分数区域 -->
    <view class="score-section">
      <view class="score-main">
        <text class="score-value" style="color: {{scoreColor}}">{{currentScore}}</text>
        <text class="score-label">得分</text>
      </view>

      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value">{{totalCount}}</text>
          <text class="stat-label">总次数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value" style="color: #22c55e">{{validCount}}</text>
          <text class="stat-label">有效</text>
        </view>
        <view class="stat-item">
          <text class="stat-value" style="color: #ef4444">{{errorCount}}</text>
          <text class="stat-label">错误</text>
        </view>
      </view>
    </view>

    <!-- 当前阶段 -->
    <view class="phase-indicator" wx:if="{{currentPhase}}">
      <text class="phase-text">{{phaseLabel}}</text>
    </view>

    <!-- 实时反馈 -->
    <view class="feedback-area" wx:if="{{issues.length > 0}}">
      <view class="feedback-item" wx:for="{{issues}}" wx:key="index">
        <text class="feedback-icon">⚠️</text>
        <text class="feedback-text">{{item}}</text>
      </view>
    </view>

    <!-- 控制按钮 -->
    <view class="controls">
      <block wx:if="{{state === 'ready'}}">
        <button class="btn btn-primary btn-lg" bindtap="startTraining">开始训练</button>
        <button class="btn btn-outline btn-lg" bindtap="startDemoMode">演示模式</button>
      </block>
      <block wx:elif="{{state === 'countdown'}}">
        <button class="btn btn-lg btn-disabled">准备中...</button>
        <button class="btn btn-sm btn-ghost force-exit" bindtap="forceExit">强制退出</button>
      </block>
      <block wx:elif="{{state === 'running'}}">
        <button class="btn btn-outline" bindtap="pauseTraining">暂停</button>
        <button class="btn btn-danger" bindtap="finishTraining">结束训练</button>
      </block>
      <block wx:elif="{{state === 'paused'}}">
        <button class="btn btn-primary btn-lg" bindtap="resumeTraining">继续训练</button>
        <button class="btn btn-danger" bindtap="finishTraining">结束训练</button>
      </block>
    </view>

    <!-- 调试按钮（训练前） -->
    <view class="debug-buttons" wx:if="{{state === 'ready'}}">
      <view class="debug-btn-row">
        <button class="btn btn-outline" bindtap="debugPhoto" style="flex:1;">📷 拍照测试</button>
        <button class="btn btn-outline" bindtap="switchAndStart" style="flex:1;">📷 后置训练</button>
      </view>
    </view>

    <!-- 强制退出（始终显示） -->
    <view class="force-exit-area" wx:if="{{state !== 'ready'}}">
      <text class="force-exit-link" bindtap="forceExit">强制退出（不保存）</text>
    </view>
  </view>
</view>
