.upload-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(135deg, #2ec4b6 0%, #1f9f93 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(46, 196, 182, 0.25);
}

.hero-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.9);
}

.section-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--bg-soft);
  border-radius: 16rpx;
}

.picker-value {
  font-size: 30rpx;
  color: var(--text);
}

.picker-arrow {
  font-size: 36rpx;
  color: var(--text-muted);
}

.empty-video {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
  border: 2rpx dashed var(--border);
  border-radius: 16rpx;
  background: var(--bg-soft);
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--primary);
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-muted);
}

.video-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-video {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #000;
}

.video-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.video-name {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-duration {
  font-size: 24rpx;
  color: var(--text-muted);
}

.video-actions {
  display: flex;
  gap: 16rpx;
}

.btn-ghost {
  flex: 1;
  background: var(--bg-soft);
  color: var(--text-secondary);
  border: none;
}

.btn-ghost.danger {
  color: var(--danger);
}

.tips-card {
  background: var(--info-soft);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.status-text {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  padding: 8rpx 16rpx 0;
  line-height: 1.6;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--border-light);
}

.footer .btn-primary {
  background: linear-gradient(135deg, #2ec4b6 0%, #1f9f93 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(46, 196, 182, 0.3);
}

.footer .btn-primary[disabled] {
  opacity: 0.55;
}
