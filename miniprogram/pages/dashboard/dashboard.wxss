/* Dashboard 首页 - 设计稿风格 */
.dashboard-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 0%, rgba(79, 140, 255, 0.18), transparent 34%),
    linear-gradient(180deg, #f7fbff 0%, #eef5ff 48%, #f8fbff 100%);
}

.dashboard-scroll {
  padding: 0 26rpx;
}

/* Hero 横幅 */
.hero-card {
  margin: 18rpx 0 28rpx;
  border-radius: 30rpx;
  position: relative;
  overflow: hidden;
  height: 244rpx;
  box-shadow: 0 22rpx 52rpx rgba(44, 100, 220, 0.24);
  background:
    radial-gradient(circle at 76% 78%, rgba(124, 104, 255, 0.9), transparent 28%),
    radial-gradient(circle at 72% 96%, rgba(47, 214, 255, 0.8), transparent 24%),
    linear-gradient(135deg, #0750c8 0%, #1d65e8 58%, #7a62f6 100%);
}

.hero-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(3, 45, 132, 0.32), rgba(19, 93, 225, 0.05) 58%, rgba(123, 95, 255, 0.18));
  z-index: 1;
}

.hero-bg {
  position: absolute;
  right: -26rpx;
  bottom: -2rpx;
  width: 430rpx;
  height: 244rpx;
  display: block;
  z-index: 1;
}

.hero-text {
  position: absolute;
  left: 42rpx;
  top: 46rpx;
  z-index: 2;
}

.hero-tip {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.28;
  text-shadow: 0 4rpx 12rpx rgba(0, 32, 112, 0.18);
}

.hero-sub {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  letter-spacing: 1rpx;
}

/* 2x2 功能宫格 */
.grid-2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-bottom: 30rpx;
}

.grid-item {
  min-height: 176rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 34rpx rgba(38, 69, 128, 0.09);
}

.grid-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(239,246,255,0.62));
  z-index: 0;
}

.grid-art {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  width: 168rpx;
  height: 138rpx;
  z-index: 1;
}

.grid-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #101727;
  margin-bottom: 6rpx;
  position: relative;
  z-index: 2;
}

.grid-sub {
  font-size: 22rpx;
  color: #66718a;
  position: relative;
  z-index: 2;
  max-width: 190rpx;
}

.grid-arrow {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 36rpx;
  line-height: 38rpx;
  text-align: center;
  font-weight: 700;
  z-index: 2;
  box-shadow: 0 8rpx 18rpx rgba(47, 111, 224, 0.22);
}

.grid-blue .grid-arrow { background: linear-gradient(135deg, #5b9dff, #276bff); }
.grid-cyan .grid-arrow { background: linear-gradient(135deg, #29d7c7, #10bfae); }
.grid-purple .grid-arrow { background: linear-gradient(135deg, #927cff, #6b5bff); }
.grid-orange .grid-arrow { background: linear-gradient(135deg, #ff9a52, #ff6424); }

/* 通用 section 头部 */
.section-card {
  padding: 26rpx 26rpx 30rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 36rpx rgba(48, 74, 120, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 今日数据 4 项 */
.data-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.data-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.data-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.9), 0 8rpx 18rpx rgba(31, 67, 132, 0.08);
}

.data-icon-blue { background: linear-gradient(145deg, #e8f2ff, #ffffff); }
.data-icon-yellow { background: linear-gradient(145deg, #fff7dc, #ffffff); }
.data-icon-orange { background: linear-gradient(145deg, #ffe7da, #ffffff); }
.data-icon-cyan { background: linear-gradient(145deg, #d9fbf6, #ffffff); }

.data-glyph {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.data-glyph-train::before,
.data-glyph-train::after {
  content: '';
  position: absolute;
  top: 13rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 5rpx;
  background: #2f7cff;
}

.data-glyph-train::before { left: 0; }
.data-glyph-train::after { right: 0; }
.data-glyph-train {
  border-top: 6rpx solid #2f7cff;
  border-bottom: 6rpx solid #2f7cff;
  border-radius: 6rpx;
}

.data-glyph-score::before {
  content: '★';
  position: absolute;
  inset: -8rpx 0 0;
  color: #f7b51f;
  font-size: 44rpx;
  line-height: 1;
}

.data-glyph-fire::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 2rpx;
  width: 22rpx;
  height: 30rpx;
  border-radius: 18rpx 18rpx 20rpx 4rpx;
  background: linear-gradient(180deg, #ff9b42, #ff4f27);
  transform: rotate(38deg);
}

.data-glyph-time {
  border: 5rpx solid #12bfae;
  border-radius: 50%;
}

.data-glyph-time::before {
  content: '';
  position: absolute;
  left: 15rpx;
  top: 6rpx;
  width: 4rpx;
  height: 16rpx;
  background: #12bfae;
  border-radius: 4rpx;
  transform-origin: bottom;
  transform: rotate(35deg);
}

.data-value-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.data-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.1;
}

.data-unit {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-left: 2rpx;
}

.data-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 推荐训练 */
.recommend-card {
  padding: 24rpx;
}

.recommend-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(244, 248, 255, 0.98) 0%, rgba(236, 246, 255, 0.9) 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(230, 239, 255, 0.92);
}

.recommend-image {
  width: 210rpx;
  height: 150rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  box-shadow: 0 14rpx 30rpx rgba(47, 111, 224, 0.16);
  background: #e8f1ff;
}

.recommend-info {
  flex: 1;
  min-width: 0;
}

.recommend-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.recommend-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.recommend-cta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  flex-shrink: 0;
}

.recommend-arrow {
  font-size: 32rpx;
  line-height: 1;
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.quick-item:nth-child(1) .quick-icon { background: #e6f1ff; }
.quick-item:nth-child(2) .quick-icon { background: #e7faf2; }
.quick-item:nth-child(3) .quick-icon { background: #fff0e6; }
.quick-item:nth-child(4) .quick-icon { background: #f0eaff; }

.quick-text {
  font-size: 24rpx;
  color: var(--text);
}
