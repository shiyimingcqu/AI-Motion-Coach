<!-- 首页 Dashboard -->
<view class="dashboard-page">
  <scroll-view class="dashboard-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- Hero 横幅 -->
    <view class="hero-card">
      <view class="hero-text">
        <view class="hero-emoji">💪</view>
        <view class="hero-tip">今天继续训练，</view>
        <view class="hero-tip">保持标准动作！</view>
      </view>
      <view class="hero-illu">
        <view class="hero-runner"></view>
      </view>
    </view>

    <!-- 2x2 功能宫格 -->
    <view class="grid-2x2">
      <view class="grid-item grid-blue" bindtap="goToTraining">
        <view class="grid-icon-wrap grid-icon-blue">
          <text class="grid-icon">📷</text>
        </view>
        <view class="grid-title">开始实时评估</view>
        <view class="grid-sub">摄像头实时识别</view>
      </view>
      <view class="grid-item grid-cyan" bindtap="goToVideoAnalysis">
        <view class="grid-icon-wrap grid-icon-cyan">
          <text class="grid-icon">☁️</text>
        </view>
        <view class="grid-title">上传视频分析</view>
        <view class="grid-sub">捕捉识别分析</view>
      </view>
      <view class="grid-item grid-purple" bindtap="goToReports">
        <view class="grid-icon-wrap grid-icon-purple">
          <text class="grid-icon">📋</text>
        </view>
        <view class="grid-title">训练记录</view>
        <view class="grid-sub">查看历史训练数据</view>
      </view>
      <view class="grid-item grid-orange" bindtap="goToExercises">
        <view class="grid-icon-wrap grid-icon-orange">
          <text class="grid-icon">📚</text>
        </view>
        <view class="grid-title">动作库</view>
        <view class="grid-sub">学习标准动作要领</view>
      </view>
    </view>

    <!-- 今日数据概览 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">今日数据概览</text>
        <text class="section-more" bindtap="goToReports">查看更多 ›</text>
      </view>
      <view class="data-grid">
        <view class="data-item">
          <view class="data-icon data-icon-blue">🏋️</view>
          <view class="data-value">{{stats.todaySessions}}</view>
          <view class="data-unit">次</view>
          <view class="data-label">训练次数</view>
        </view>
        <view class="data-item">
          <view class="data-icon data-icon-yellow">⭐</view>
          <view class="data-value">{{stats.averageScore}}</view>
          <view class="data-unit">分</view>
          <view class="data-label">平均得分</view>
        </view>
        <view class="data-item">
          <view class="data-icon data-icon-orange">🔥</view>
          <view class="data-value">{{stats.weekSessions}}</view>
          <view class="data-unit">次</view>
          <view class="data-label">锻炼次数</view>
        </view>
        <view class="data-item">
          <view class="data-icon data-icon-cyan">⏱</view>
          <view class="data-value">{{stats.totalDuration}}</view>
          <view class="data-unit">分钟</view>
          <view class="data-label">完成时长</view>
        </view>
      </view>
    </view>

    <!-- 推荐训练 -->
    <view class="card section-card recommend-card" wx:if="{{recommended}}">
      <view class="section-header">
        <text class="section-title">推荐训练</text>
        <text class="section-more" bindtap="shuffleRecommend">换一换</text>
      </view>
      <view class="recommend-body" bindtap="goToRecommend">
        <view class="recommend-emoji">{{recommended.icon}}</view>
        <view class="recommend-info">
          <view class="recommend-title">{{recommended.name}}训练</view>
          <view class="recommend-tags">
            <text class="tag tag-primary">{{recommended.level}}</text>
            <text class="tag tag-primary">{{recommended.duration}}</text>
            <text class="tag tag-primary">{{recommended.people}}人训练</text>
          </view>
        </view>
        <view class="recommend-cta">
          <text>开始训练</text>
          <text class="recommend-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">快捷入口</text>
      </view>
      <view class="quick-grid">
        <view class="quick-item" bindtap="goToWarmup">
          <view class="quick-icon">🏃</view>
          <view class="quick-text">热身指导</view>
        </view>
        <view class="quick-item" bindtap="goToStretch">
          <view class="quick-icon">🧘</view>
          <view class="quick-text">拉伸放松</view>
        </view>
        <view class="quick-item" bindtap="goToPlan">
          <view class="quick-icon">📅</view>
          <view class="quick-text">训练计划</view>
        </view>
        <view class="quick-item" bindtap="goToFavorites">
          <view class="quick-icon">⭐</view>
          <view class="quick-text">我的收藏</view>
        </view>
      </view>
    </view>

    <view style="height: 40rpx;"></view>
  </scroll-view>
</view>
