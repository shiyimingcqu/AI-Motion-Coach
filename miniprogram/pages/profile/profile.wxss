/* 个人中心 - 设计稿风格 */
.profile-page {
  min-height: 100vh;
  background: var(--bg);
}

/* 顶部 */
.top-bar {
  background: var(--bg);
}

.top-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 56rpx;
  color: var(--text);
  line-height: 1;
}

.top-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.more-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text);
  letter-spacing: -2rpx;
}

.profile-scroll {
  padding: 0 24rpx;
}

/* 用户卡 */
.user-card {
  background: #fff;
  border-radius: var(--radius-xl);
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 0 24rpx;
  box-shadow: var(--shadow-card);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #cbe0ff 0%, #d4c4ff 100%);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.user-level {
  background: linear-gradient(135deg, #4f8cff 0%, #7c6cf5 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
}

.user-sub {
  font-size: 22rpx;
  color: var(--text-muted);
}

.user-days {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.user-days-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.user-days-unit {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
}

.user-days-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 通用 section */
.section-card {
  padding: 24rpx 24rpx 28rpx;
  background: #fff;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 趋势 */
.trend-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trend-average {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.trend-average-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.trend-average-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #34d399;
}

.trend-chart-wrap {
  position: relative;
}

.trend-svg-wrap {
  position: relative;
  height: 300rpx;
  width: 100%;
}

.trend-rich {
  display: block;
  width: 100%;
  height: 100%;
}

.trend-xaxis {
  display: flex;
  justify-content: space-between;
  padding: 0 4rpx;
  margin-top: 12rpx;
}

.trend-xaxis-label {
  font-size: 22rpx;
  color: var(--text-muted);
  flex: 1;
  text-align: center;
}

/* 训练记录 */
.session-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.session-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #fafbfd;
  border-radius: var(--radius);
}

.session-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #e9f0ff 0%, #f6e9ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.session-thumb-icon {
  font-size: 40rpx;
}

.session-mid {
  flex: 1;
  min-width: 0;
}

.session-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  display: block;
}

.session-meta {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  flex-wrap: wrap;
}

.session-time-icon,
.session-duration-icon {
  font-size: 20rpx;
  margin-right: 2rpx;
}

.session-dot {
  margin: 0 6rpx;
  color: var(--text-placeholder);
}

.session-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.session-score {
  font-size: 30rpx;
  font-weight: 700;
}

.session-status {
  font-size: 20rpx;
  color: #0e9b6d;
  background: var(--success-soft);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
}

/* 荣誉卡 */
.honor-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 4rpx;
}

.honor-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

.honor-trophy { background: linear-gradient(180deg, #fff7e0 0%, #fff 100%); }
.honor-fire { background: linear-gradient(180deg, #ffeae0 0%, #fff 100%); }
.honor-target { background: linear-gradient(180deg, #e7eaff 0%, #fff 100%); }

.honor-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.honor-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  display: inline-block;
}

.honor-unit {
  font-size: 22rpx;
  color: var(--text-muted);
  display: inline-block;
  margin-left: 2rpx;
}

.honor-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 退出登录 */
.logout-section {
  margin-top: 12rpx;
  padding: 0;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border: none;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  color: #ef4444;
  font-weight: 500;
  box-shadow: var(--shadow-card);
}

.logout-btn::after {
  border: none;
}
