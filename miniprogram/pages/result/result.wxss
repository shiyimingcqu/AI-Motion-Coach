/* 评估报告页 - 设计稿风格 */
.result-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* 顶部 */
.top-bar {
  background: #fff;
}

.top-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 56rpx;
  color: var(--text);
  line-height: 1;
}

.top-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.share-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text);
}

.result-scroll {
  flex: 1;
  padding: 0 24rpx;
}

/* 综合评分卡（蓝色渐变） */
.score-hero {
  margin: 20rpx 0 24rpx;
  padding: 32rpx 28rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, #4f8cff 0%, #6da7ff 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(79, 140, 255, 0.25);
}

.score-hero::before {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
}

.score-hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.score-hero-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-hero-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.score-hero-num {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.score-hero-value {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}

.score-hero-unit {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.score-hero-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.score-tag {
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 600;
}

.score-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  color: #fbbf24;
  font-size: 28rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.score-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  position: relative;
  z-index: 1;
}

.dot-sep {
  font-size: 22rpx;
}

/* Section 通用 */
.section-card {
  padding: 28rpx 28rpx 32rpx;
  background: #fff;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
}

/* 雷达图（SVG） */
.radar-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 8rpx;
}

.radar-svg-wrap {
  position: relative;
  width: 500rpx;
  height: 460rpx;
}

.radar-rich {
  display: block;
  width: 100%;
  height: 100%;
}

.radar-labels {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.radar-label {
  position: absolute;
  font-size: 22rpx;
  color: var(--text);
  font-weight: 500;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.radar-label-top {
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}

.radar-label-right {
  top: 36%;
  right: 4rpx;
}

.radar-label-bottom {
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}

.radar-label-left {
  top: 36%;
  left: 4rpx;
}

.radar-label-left-bottom {
  bottom: 24%;
  right: 4rpx;
}

.radar-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-blue { background: #4f8cff; }
.legend-gray { background: #d0d6e0; }

/* 关键问题分析 */
.issue-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.issue-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: #fafbfd;
  border-radius: var(--radius);
  position: relative;
}

.issue-bullet {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ff8a5b;
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.issue-item:nth-child(2) .issue-bullet { background: #fbbf24; }
.issue-item:nth-child(3) .issue-bullet { background: #4f8cff; }

.issue-content {
  flex: 1;
  min-width: 0;
}

.issue-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4rpx;
}

.issue-desc {
  font-size: 22rpx;
  color: var(--text-muted);
}

.issue-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
  align-self: flex-start;
}

.issue-tag-major {
  background: #fde2d8;
  color: #d96a36;
}

.issue-tag-minor {
  background: #e6f1ff;
  color: #2f6fe0;
}

/* 改进建议 */
.suggest-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.suggest-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.suggest-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.suggest-icon-green { background: var(--success-soft); color: #0e9b6d; }
.suggest-icon-blue { background: var(--primary-light); color: var(--primary); }
.suggest-icon-orange { background: #ffe9df; color: #d96a36; }

.suggest-text {
  flex: 1;
  min-width: 0;
}

.suggest-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4rpx;
}

.suggest-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 底部 */
.result-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.footer-btn {
  flex: 1;
}

.footer-btn[disabled] {
  opacity: 0.65;
}
