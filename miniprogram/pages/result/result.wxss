/* 结果页样式 */
.result-page {
  min-height: 100vh;
  background: var(--bg);
}

/* 头部 */
.result-header {
  position: relative;
  padding: 60rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -50%;
  left: -20%;
  width: 140%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
}

.exercise-tag {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.score-ring-wrapper {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}

.result-message {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  position: relative;
  z-index: 1;
}

/* 内容区 */
.result-content {
  padding: 24rpx;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

/* 数据卡片 */
.stats-card {
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-box {
  width: 50%;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}

.stat-box:nth-child(2n) {
  border-right: none;
}

.stat-box:nth-child(3),
.stat-box:nth-child(4) {
  border-bottom: none;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}

.stat-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 阶段 */
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.phases-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.phase-badge {
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(59, 130, 246, 0.1);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
}

/* 改进建议 */
.improve-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.improve-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 底部 */
.result-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.result-footer .btn {
  flex: 1;
}
