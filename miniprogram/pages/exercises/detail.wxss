/* 动作详情 - 设计稿风格 */
.detail-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 16% 0%, rgba(79, 140, 255, 0.15), transparent 36%),
    linear-gradient(180deg, #f7fbff 0%, #eef5ff 48%, #f9fbff 100%);
  padding-bottom: 140rpx;
}

/* 顶部 */
.top-bar {
  background: transparent;
}

.top-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 56rpx;
  color: var(--text);
  line-height: 1;
}

.top-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.top-bar-right {
  width: 60rpx;
}

/* 头部 */
.detail-hero {
  margin: 16rpx 28rpx 0;
  border-radius: 30rpx;
  padding: 38rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
  position: relative;
  overflow: hidden;
  min-height: 220rpx;
  box-shadow: 0 20rpx 46rpx rgba(47, 111, 224, 0.22);
}

.detail-hero::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
}

.detail-hero-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.detail-image {
  width: 244rpx;
  height: 178rpx;
  border-radius: 24rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 16rpx 34rpx rgba(0, 34, 112, 0.18);
}

.detail-icon {
  font-size: 88rpx;
  position: relative;
  z-index: 2;
  filter: drop-shadow(0 2rpx 8rpx rgba(0,0,0,0.1));
}

.detail-name {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 22rpx;
}

.detail-tags {
  display: flex;
  gap: 12rpx;
}

.detail-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.22);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
}

/* section */
.detail-content {
  padding: 22rpx 28rpx 0;
}

.section-card {
  padding: 26rpx 26rpx 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 26rpx;
  border: 1rpx solid rgba(255,255,255,0.95);
  box-shadow: 0 12rpx 34rpx rgba(38, 69, 128, 0.08);
  margin-bottom: 20rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.mode-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mode-item {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
}

.error-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.error-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.error-bullet {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #ffe9df;
  color: #d96a36;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.stats-row {
  display: flex;
  gap: 40rpx;
  justify-content: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* 底部按钮 */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid var(--border-light);
}

.detail-footer .btn {
  background: linear-gradient(135deg, #4f8cff 0%, #2f6fe0 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(79, 140, 255, 0.3);
}
