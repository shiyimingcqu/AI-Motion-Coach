/* 动作详情 */
.detail-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 140rpx;
}

/* 头部 */
.detail-header {
  padding: 48rpx 24rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.detail-tags {
  display: flex;
  gap: 12rpx;
}

.detail-tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
}

/* 内容 */
.detail-content {
  padding: 24rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 2;
}

.desc-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.mode-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mode-item {
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(59, 130, 246, 0.1);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
}

.error-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.error-item {
  display: flex;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.error-dot {
  color: var(--danger);
}

/* 统计 */
.stats-row {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* 底部按钮 */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid var(--border);
}

.detail-footer .btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
}
