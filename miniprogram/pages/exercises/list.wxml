<!-- 动作库列表页 -->
<view class="exercises-page">
  <!-- 搜索 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索动作..." value="{{keyword}}" bindinput="onSearch" />
  </view>

  <!-- 分类 Tab -->
  <scroll-view class="category-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="tab-item {{activeCategory === item ? 'tab-active' : ''}}"
      wx:for="{{categories}}"
      wx:key="index"
      bindtap="switchCategory"
      data-category="{{item}}"
    >{{item}}</view>
  </scroll-view>

  <!-- 动作列表 -->
  <view class="exercise-list">
    <exercise-card
      wx:for="{{filteredExercises}}"
      wx:key="key"
      exercise="{{item}}"
      bindtap="goToDetail"
      data-key="{{item.key}}"
    ></exercise-card>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredExercises.length === 0 && !loading}}">
    <text class="icon">🔍</text>
    <text>没有找到匹配的动作</text>
  </view>
</view>
