/* 动作库列表 */
.exercises-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

/* 搜索 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border-radius: var(--radius-full);
  padding: 0 32rpx;
  font-size: 28rpx;
  box-shadow: var(--shadow);
  box-sizing: border-box;
}

/* 分类 Tab */
.category-tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #fff;
  box-shadow: var(--shadow);
}

.tab-active {
  background: var(--primary);
  color: #fff;
}

/* 动作列表 */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
