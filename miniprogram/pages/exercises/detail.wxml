<!-- 动作详情页 -->
<view class="detail-page">
  <!-- 顶部导航 -->
  <view class="top-bar">
    <view class="top-bar-content">
      <view class="back-btn" bindtap="goBack">
        <text class="back-arrow">‹</text>
      </view>
      <text class="top-title">{{exercise.name}}</text>
      <view class="top-bar-right"></view>
    </view>
  </view>

  <!-- 头部 -->
  <view class="detail-hero" style="background: linear-gradient(135deg, {{exercise.accentColor}}, {{exercise.accentColor}}cc);">
    <view class="detail-icon">{{exercise.icon}}</view>
    <view class="detail-name">{{exercise.name}}</view>
    <view class="detail-tags">
      <text class="detail-tag">{{exercise.category}}</text>
      <text class="detail-tag">{{exercise.level}}</text>
      <text class="detail-tag">{{exercise.duration}}</text>
    </view>
  </view>

  <view class="detail-content">
    <!-- 描述 -->
    <view class="card section-card" wx:if="{{exercise.description}}">
      <view class="section-title-text">动作简介</view>
      <text class="desc-text">{{exercise.description}}</text>
    </view>

    <!-- 检测模式 -->
    <view class="card section-card" wx:if="{{exercise.modes.length > 0}}">
      <view class="section-title-text">支持模式</view>
      <view class="mode-list">
        <view class="mode-item" wx:for="{{exercise.modes}}" wx:key="index">
          {{item}}
        </view>
      </view>
    </view>

    <!-- 常见错误 -->
    <view class="card section-card" wx:if="{{exercise.errors.length > 0}}">
      <view class="section-title-text">常见错误</view>
      <view class="error-list">
        <view class="error-item" wx:for="{{exercise.errors}}" wx:key="index">
          <view class="error-bullet">!</view>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 训练统计 -->
    <view class="card section-card" wx:if="{{exerciseStats}}">
      <view class="section-title-text">我的训练</view>
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-num">{{exerciseStats.total || 0}}</text>
          <text class="stat-label">训练次数</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{exerciseStats.avgScore || 0}}</text>
          <text class="stat-label">平均分</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 开始训练 -->
  <view class="detail-footer">
    <button class="btn btn-primary btn-lg" bindtap="startTraining">开始训练</button>
  </view>
</view>
