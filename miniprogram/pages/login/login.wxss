/* 登录页样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 60%, #f5f5f5 60%);
  display: flex;
  flex-direction: column;
}

.login-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  padding-bottom: 60rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 登录按钮区域 */
.login-buttons {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.wechat-login-btn {
  width: 100%;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  font-size: 32rpx;
}

.other-login-divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0 24rpx;
}

.other-login-divider::before,
.other-login-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e5e7eb;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 表单 */
.form-group {
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.toggle-account {
  text-align: center;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #3b82f6;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 40rpx;
  font-size: 22rpx;
  color: #9ca3af;
}
