/* 登录页样式 - 按设计稿改造 */

page {
  background: #f5f7fa;
}

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
}

/* ========== 顶部渐变区域 ========== */
.login-header {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  padding-bottom: 80rpx;
  background: linear-gradient(180deg, #4F6BF7 0%, #6B5FF7 40%, #9B6FF7 70%, #C9A0DC 100%);
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
}

/* 背景光晕效果 */
.login-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  pointer-events: none;
}

/* Logo 图片 */
.logo-image {
  width: 85%;
  height: auto;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 8rpx 24rpx rgba(0,0,0,0.15));
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 2rpx;
}

/* ========== 白色卡片区域 ========== */
.login-card {
  margin: -40rpx 40rpx 0;
  padding: 56rpx 40rpx 44rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(79,107,247,0.12);
  z-index: 10;
}

/* 微信一键登录按钮 */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #34C759, #30B354);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(52,199,89,0.3);
  letter-spacing: 2rpx;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 36rpx 0 28rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e8e8e8;
}

.divider-text {
  padding: 0 28rpx;
  font-size: 24rpx;
  color: #b0b0b0;
}

/* ========== 表单区域 ========== */
.form-group {
  margin-bottom: 24rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f6f7fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.input:focus {
  border-color: #4F6BF7;
  background: #fff;
}

.account-login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4F6BF7;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-top: 8rpx;
}

.account-login-btn::after {
  border: none;
}

/* 切换账号登录 */
.toggle-account {
  text-align: center;
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #4F6BF7;
  font-weight: 500;
}

/* ========== 底部间距 ========== */
.login-spacer {
  flex: 1;
  min-height: 60rpx;
}

/* 底部协议提示 */
.footer-tip {
  text-align: center;
  padding: 32rpx 48rpx 56rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.link-text {
  color: #4F6BF7;
}
