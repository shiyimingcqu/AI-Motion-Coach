/* 全局样式 - 运动姿态评估与纠错系统 */

page {
  /* 主色 */
  --primary: #4f8cff;
  --primary-dark: #2f6fe0;
  --primary-light: #e8f0ff;
  --primary-soft: #f4f8ff;

  /* 状态色 */
  --success: #34d399;
  --success-soft: #e7faf2;
  --warning: #fbbf24;
  --warning-soft: #fff7e0;
  --danger: #f87171;
  --danger-soft: #fdecec;
  --info: #60a5fa;
  --info-soft: #e6f1ff;

  /* 强调色（用于功能宫格） */
  --accent-blue: #4f8cff;
  --accent-cyan: #2ec4b6;
  --accent-purple: #7c6cf5;
  --accent-orange: #ff8a5b;

  /* 背景 */
  --bg: #f5f7fb;
  --bg-white: #ffffff;
  --bg-card: #ffffff;
  --bg-soft: #f0f4fa;

  /* 文字 */
  --text: #1f2330;
  --text-secondary: #5b6175;
  --text-muted: #9aa1b3;
  --text-placeholder: #c5cad6;

  /* 边框与阴影 */
  --border: #eceff5;
  --border-light: #f3f5f9;
  --shadow: 0 4rpx 16rpx rgba(28, 40, 80, 0.05);
  --shadow-lg: 0 8rpx 32rpx rgba(28, 40, 80, 0.08);
  --shadow-card: 0 6rpx 20rpx rgba(31, 35, 48, 0.04);

  /* 圆角 */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --radius-full: 9999rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, 'Segoe UI', Roboto, sans-serif;
  font-size: 26rpx;
  color: var(--text);
  background-color: var(--bg);
  line-height: 1.55;
}

/* 通用布局 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg);
}

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  outline: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-outline {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary-light);
}

.btn-danger {
  background: linear-gradient(135deg, var(--danger), #ef4444);
  color: #fff;
}

.btn-lg {
  height: 96rpx;
  font-size: 32rpx;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 文字 */
.text-primary { color: var(--primary); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-danger { color: var(--danger); }
.text-muted { color: var(--text-muted); }
.text-secondary { color: var(--text-secondary); }
.text-center { text-align: center; }
.text-bold { font-weight: 700; }

/* Flex 布局 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* 间距 */
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-muted);
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: var(--text-muted);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-success {
  background: var(--success-soft);
  color: #0e9b6d;
}

.tag-warning {
  background: var(--warning-soft);
  color: #b8830c;
}

.tag-danger {
  background: var(--danger-soft);
  color: #c14a4a;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
}
